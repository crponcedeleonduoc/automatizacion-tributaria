# El proyecto se ejecuta dentro de contenedores Linux: el repositorio guarda LF.
* text=auto eol=lf

# Scripts de Windows: necesitan CRLF.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binarios: Git no debe tocarlos.
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.pdf binary
*.docx binary
*.xlsx binary
*.pptx binary
