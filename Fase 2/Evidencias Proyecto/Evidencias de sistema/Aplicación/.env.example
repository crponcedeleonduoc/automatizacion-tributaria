# ============================================================
# aSIIstente — configuración. Copia este archivo a .env y edita.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   Linux/VPS:             cp .env.example .env
# NUNCA subas .env a git ni lo compartas.
# ============================================================

# --- Base de datos ---
POSTGRES_DB=asiistente
POSTGRES_USER=asiistente
POSTGRES_PASSWORD=cambia-esta-clave-larga

# --- Seguridad de la aplicación ---
# Clave para firmar los tokens de sesión de los usuarios (JWT).
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=GENERAR_CON_EL_COMANDO_DEL_README

# Clave con la que se cifran las claves tributarias en la base de datos.
# DEBE ser una clave Fernet válida. Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Si la pierdes, las credenciales guardadas quedan irrecuperables (por diseño).
CREDENCIALES_KEY=GENERAR_CON_EL_COMANDO_DEL_README

# Minutos que dura la sesión del usuario en el panel
SESION_MINUTOS=720

# --- Frontend ---
# URL pública de la API tal como la ve el navegador del usuario.
# Local: http://localhost:8000     Producción: https://tudominio.cl
NEXT_PUBLIC_API_URL=http://localhost:8000
# Número de WhatsApp de contacto, formato internacional sin "+"
WHATSAPP_NUMERO=56912345678

# --- Producción (solo VPS, usado por docker-compose.prod.yml) ---
DOMINIO=asiistente.cl
EMAIL_ADMIN=contacto@asiistente.cl

# --- Correo para alertas (opcional en local; SMTP de tu proveedor) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=alertas@asiistente.cl
# Gmail personal para probar: SMTP_HOST=smtp.gmail.com SMTP_PORT=587
#   SMTP_USER=tucorreo@gmail.com SMTP_PASSWORD=<contraseña de aplicación> SMTP_FROM=tucorreo@gmail.com
# URL pública del sitio para los enlaces de los correos (local: http://localhost:3000)
URL_WEB=http://localhost:3000
# Correos que son administradores (separados por coma): ven /panel/admin
ADMIN_EMAILS=

# --- Motor SII ---
# Pausa mínima entre consultas al SII por sesión (segundos). No bajar de 0.35.
SII_PAUSA=0.5
# Segundos que se mantiene el candado de "una sesión por RUT" como máximo
RUT_LOCK_SEGUNDOS=600
